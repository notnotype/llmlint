# 依赖 / Dependencies
node_modules/
.bun/

# Agent 润色流程产物（check/fix 不写这里，是 skill workflow 的输出目录）
# Agent polish workflow outputs (.agent/polish-input.md / polish-plan.md / polish-output.md ...)
.agent/

# 本地开发数据库（web 的 DATABASE_URL=file:./data.db 默认落在仓库根）
data.db
data.db-journal
data.db-wal
data.db-shm

# 日志 / Logs
*.log

# 编辑器 / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# llmlint 评测临时输出。evals/ 本身是开发仓的一等资产，进入 git；但下面这些是可再生的跑分产物，不进 git（每跑必变、churn 大）。
evals/fixture-report/
evals/report/
evals/tmp/
evals/.cache/

# eval 真实配置（可含 CLI provider 密钥）；模板 = evals/eval.config.example.json 进 git
evals/eval.config.json
