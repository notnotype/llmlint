  {
    "id": "cn.punctuation.dedup.repeated-symbols",
    "namespace": "punctuation.dedup",
    "title": "连续符号去重",
    "level": "medium",
    "enabled": true,
    "review": "human",
    "fixability": "manual",
    "note": "默认降级：重复感叹号/问号在小说对白和拟声中常承担语气，当前 reference 命中高于 render；只作为人工提示，不再自动去重。",
    "source": {
      "canonicalKey": "punctuation.dedup\t\t([,，。~～!！?？])\\1+",
