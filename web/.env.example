# llmlint web 采集站环境变量。复制为 .env 后按需修改（.env 已 gitignore）。

# 本地 SQLite 库路径（libSQL adapter，只支持 file: 前缀）。
# 注意：prisma migrate/generate 也读这个变量——不设会导致 schema engine 报空错。
DATABASE_URL="file:./data.db"

# nuxt-auth-utils 的密封 cookie 密钥，必须 ≥32 字符。
# 生产环境务必换成随机强密钥（例：openssl rand -base64 48）。
NUXT_SESSION_PASSWORD="change-me-to-a-random-string-at-least-32-chars"

# 登录开关。开发环境默认 false，生产必须开启并同时启用 NeuroBook SSO。
# false：本地请求使用稳定的开发身份，不依赖 Cookie；生产配置门禁不会允许关闭 SSO。
# true：启用 llmlint 自有 sealed session，唯一登录入口是 NeuroBook 官方 OAuth。
NUXT_AUTH_ENABLED="false"

# —— NeuroBook OAuth SSO（生产必填；secret 只放部署机 secrets/web.env）——
# NUXT_NEUROBOOK_OAUTH_ENABLED="false"
# NUXT_NEUROBOOK_OAUTH_ISSUER="https://nbook.notnotype.com"
# NUXT_NEUROBOOK_OAUTH_CLIENT_ID="llmlint-web"
# NUXT_NEUROBOOK_OAUTH_CLIENT_SECRET="<部署机注入，禁止写入仓库>"
# NUXT_NEUROBOOK_OAUTH_REDIRECT_URI="https://llmlint.notnotype.com/auth/neurobook"
# NUXT_NEUROBOOK_ADMIN_USER_ID="1"

# —— LLM 异步分类补空通道（Task 13 W6，可选）——
# 服务端读 <仓根>/evals/eval.config.json 的 classifier.model / modelsConfig 链做上传后异步分类；
# API key 只存在于 modelsConfig 指向的 NeuroBook config.json 里，绝不写进 web/.env* 等入 git 文件。
# 配置文件或 classifier 节缺失时该通道自动禁用，不影响上传主流程。
# 如需指向其它 eval 配置（默认 = 构建期按仓根解析出的绝对路径），用绝对路径覆盖：
# NUXT_EVAL_CONFIG_PATH="C:/path/to/eval.config.json"
