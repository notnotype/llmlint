{
    "name": "llmlint-dev",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "description": "Development workspace for llmlint. The installable Agent Skill package lives in ./skill.",
    "license": "PolyForm-Noncommercial-1.0.0",
    "repository": {
        "type": "git",
        "url": "git@github.com:notnotype/llmlint.git"
    },
    "scripts": {
        "test": "vitest run",
        "typecheck": "tsc --noEmit --pretty false",
        "verify": "bun run typecheck && bun test && bun skill/bin/llmlint.ts --version && bun skill/bin/llmlint.ts show-llm-rules --format json",
        "eval:fixture": "bun evals/score.ts --corpus evals/fixtures/corpus --out .agent/evals/fixture-report --min-support 1",
        "web:dev": "cd web && bun run dev",
        "web:generate": "cd web && bun run generate",
        "web:typecheck": "cd web && bun run typecheck",
        "sync:neuro-book": "bun ../neuro-book/scripts/cli/sync-llmlint-skill.ts"
    },
    "dependencies": {
        "@earendil-works/pi-ai": "^0.75.4",
        "@gradio/client": "^2.3.0",
        "commander": "^14.0.2",
        "fflate": "^0.8.3",
        "picocolors": "^1.1.1",
        "tinyglobby": "^0.2.15"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "bun-types": "^1.3.4",
        "typescript": "^5.9.3",
        "vitest": "^4.1.2"
    }
}
