NODE_ENV=production
DATABASE_URL=file:/srv/llmlint/data/data.db
NITRO_HOST=127.0.0.1
NITRO_PORT=3020
NUXT_AUTH_ENABLED=true
NUXT_SESSION_NAME=llmlint-session
NUXT_SESSION_PASSWORD=<set-on-server-only>
NUXT_NEUROBOOK_OAUTH_ENABLED=true
NUXT_NEUROBOOK_OAUTH_ISSUER=https://nbook.notnotype.com
NUXT_NEUROBOOK_OAUTH_CLIENT_ID=llmlint-web
NUXT_NEUROBOOK_OAUTH_CLIENT_SECRET=<set-on-server-only>
NUXT_NEUROBOOK_OAUTH_REDIRECT_URI=https://llmlint.notnotype.com/auth/neurobook
NUXT_NEUROBOOK_ADMIN_USER_ID=1
NUXT_EVAL_CONFIG_PATH=/srv/llmlint/runtime/eval.config.json
